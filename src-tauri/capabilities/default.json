{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: efsp's own release commands, plus the window controls of its custom title bar.",
  "windows": ["main"],
  "permissions": [
    "allow-npcap-status",
    "allow-open-npcap-download",
    "allow-history-list",
    "allow-history-detail",
    "allow-history-export-csv",
    "allow-history-delete-all",
    "allow-settings-get",
    "allow-settings-set",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized"
  ]
}
